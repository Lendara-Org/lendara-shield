# Lendara Shield — copy to .env and fill in. TESTNET ONLY.
# Never commit real values. `make setup-testnet` prints the Stellar values.

# --- Local Postgres (docker-compose) ---
POSTGRES_USER=shield
POSTGRES_PASSWORD=shield
POSTGRES_DB=shield
POSTGRES_PORT=5432
DATABASE_URL=postgres://shield:shield@localhost:5432/shield

# --- API ---
API_PORT=8080
# json | pretty
LOG_FORMAT=pretty
# Comma-separated origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Stellar testnet ---
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- Shield keys (operator, intake and auditor are different keys, never reused) ---
# Deploys and administers the pool and the ASP
SHIELD_OPERATOR_SECRET=
# Omnibus account: receives USDC from the anchor, deposits into the pool
SHIELD_INTAKE_SECRET=
# SPP wallet (encrypted SQLite) holding the intake's pool keys and notes. Outside the repo.
SHIELD_INTAKE_WALLET_PATH=
# Global View Key: Baby JubJub keypair JSON from SPP's tools/gvkey-gen (not a Stellar key). Outside the repo.
SHIELD_GVK_KEY_FILE=

# --- Pool and asset (set by `make setup-testnet`) ---
SHIELD_POOL_CONTRACT=
SHIELD_ASSET_CONTRACT=

# --- Ramp mode (optional: leave RAMP_ANCHOR_HOME_DOMAIN empty to disable) ---
RAMP_ANCHOR_HOME_DOMAIN=
RAMP_ASSET_CODE=USDC
RAMP_ASSET_ISSUER=

# --- Admin and audit endpoints (long random strings) ---
ADMIN_TOKEN=
AUDITOR_TOKEN=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8080
