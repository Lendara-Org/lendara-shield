# Lendara Shield — copy to .env and fill in. TESTNET ONLY.
# Never commit real values. `make setup-testnet` prints the Stellar values.

# --- Local Postgres (docker-compose) ---
POSTGRES_USER=shield
POSTGRES_PASSWORD=shield
POSTGRES_DB=shield
POSTGRES_PORT=5432
DATABASE_URL=postgres://shield:shield@localhost:5432/shield

# --- API ---
API_PORT=8080
# json | pretty
LOG_FORMAT=pretty
# Comma-separated origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Onboardings plus intents one client IP may start per minute (default 20; 0 disables).
# Behind a reverse proxy every client shares the proxy's address.
RATE_LIMIT_PER_MINUTE=

# --- Web (apps/web). Defaults shown; set them for a deployed API or RPC ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- Stellar testnet ---
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- Shield keys (operator, intake and auditor are different keys, never reused) ---
# Deploys and administers the pool and the ASP
SHIELD_OPERATOR_SECRET=
# Omnibus account: receives USDC from the anchor, deposits into the pool
SHIELD_INTAKE_SECRET=
# SPP wallet (encrypted SQLite) holding the intake's pool keys and notes. Outside the repo.
SHIELD_INTAKE_WALLET_PATH=
# Global View Key: Baby JubJub keypair JSON from SPP's tools/gvkey-gen (not a Stellar key). Outside the repo.
SHIELD_GVK_KEY_FILE=

# --- Shielding worker: the pool CLI binary (`make build-pool-cli`), relative to apps/api ---
POOL_CLI_PATH=../pool-cli/target/release/pool-cli

# --- Pool and asset (written by `make setup-testnet` to its testnet.env) ---
SHIELD_DEPLOYMENT_FILE=
SHIELD_CIRCUITS_LOCK_FILE=
SHIELD_CIRCUITS_DIR=
SHIELD_POOL_CONTRACT=
SHIELD_ASSET_CONTRACT=

# --- Ramp mode (optional: leave RAMP_ANCHOR_HOME_DOMAIN empty to disable) ---
# Defaults point at the public Lendara sandbox anchor and its test USDC.
RAMP_ANCHOR_HOME_DOMAIN=lendara-monorepo-fixh.vercel.app
RAMP_ASSET_CODE=USDC
RAMP_ASSET_ISSUER=GBVIQ7QVTTJ4NLFTYYFPEKWYJWAMKDAOFYSR52ZGWJFSGTSVOO5H47B5

# --- Admin and audit endpoints: at least 32 characters, e.g. `openssl rand -hex 32` ---
ADMIN_TOKEN=
AUDITOR_TOKEN=
